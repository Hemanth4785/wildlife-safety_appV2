# Server Port (automatically set by Render or defaults to 3000 locally)
PORT=3000

# Environment mode (production for Render deployment)
NODE_ENV=production

# OpenWeather API Key (Required for live weather parameter fetching)
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# Gemini AI API Key (Required for AI assistant and route risk analysis)
GEMINI_API_KEY="your_gemini_api_key_here"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Application Public Host URL (Optional, auto-generated by Render)
APP_URL="https://wildlife-safety-app.onrender.com"
